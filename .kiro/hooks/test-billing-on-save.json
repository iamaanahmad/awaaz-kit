{
  "version": "v1",
  "hooks": [
    {
      "name": "Targeted tests on billing edits",
      "trigger": "PostFileSave",
      "description": "Run billing unit and property tests",
      "matcher": "packages/domain-billing/src/.*",
      "action": {
        "type": "command",
        "command": "node scripts/kiro-targeted-test.mjs billing",
        "timeout": 300
      }
    }
  ]
}