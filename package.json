{
  "name": "awaaz-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:order": "pnpm --filter order-awaaz dev",
    "dev:bill": "pnpm --filter bill-awaaz dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:offline": "vitest run --dir packages/sync-engine --dir packages/local-data && playwright test --grep @offline",
    "lint": "eslint . && depcruise packages apps --config .dependency-cruiser.cjs",
    "format": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build && node scripts/build-hub.mjs",
    "build:hub": "node scripts/build-hub.mjs",
    "reuse-report": "node scripts/reuse-report.mjs",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
